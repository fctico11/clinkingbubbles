---
import { FaInstagram, FaFacebookF, FaEnvelope, FaExternalLinkAlt } from "react-icons/fa";
import { SiTiktok } from "react-icons/si";

const year = new Date().getFullYear();
---

<footer class="bg-[#EBE6D6] text-white py-10 px-6 text-center">
  <div class="max-w-4xl mx-auto">
    {/* Navigation Links with separators */}
    <div class="flex flex-wrap items-center justify-center gap-x-2 gap-y-2 mb-6">
      <a href="/" class="bubbles-font text-base text-black hover:text-yellow-500 transition">Home</a>
      <span class="text-black">|</span>
      <a href="/about" class="bubbles-font text-base text-black hover:text-yellow-500 transition">About</a>
      <span class="text-black">|</span>
      <a href="/services" class="bubbles-font text-base text-black hover:text-yellow-500 transition">Services</a>
      <span class="text-black">|</span>
      <a href="/packages" class="bubbles-font text-base text-black hover:text-yellow-500 transition">Packages</a>
      <span class="text-black">|</span>
      <a href="/service-areas" class="bubbles-font text-base text-black hover:text-yellow-500 transition">Service Areas</a>
      <span class="text-black">|</span>
      <a href="/booking-process" class="bubbles-font text-base text-black hover:text-yellow-500 transition">Booking Process</a>
      <span class="text-black">|</span>
      <a href="/alcohol-calculator" class="bubbles-font text-base text-black hover:text-yellow-500 transition">Alcohol Calculator</a>
      <span class="text-black">|</span>
      <a href="/faq" class="bubbles-font text-base text-black hover:text-yellow-500 transition">FAQ</a>
      <span class="text-black">|</span>
      <a href="/contact" class="bubbles-font text-base text-black hover:text-yellow-500 transition">Contact</a>
    </div>

    {/* Social Icons */}
    <div class="flex justify-center space-x-6 mb-6">
      <a href="https://www.instagram.com/clinkingbubbles" target="_blank" rel="noopener noreferrer" aria-label="Clinking Bubbles Instagram">
        <div class="relative inline-block w-[30px] h-[30px]" aria-hidden="true">
          <FaInstagram size={28} className="absolute top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2 text-black" />
          <FaInstagram size={24} className="absolute top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2 text-black" />
          <FaInstagram size={26} className="absolute top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2 text-white hover:text-yellow-500 transition" />
        </div>
      </a>

      <a href="https://www.tiktok.com/@clinkingbubbles" target="_blank" rel="noopener noreferrer" aria-label="Clinking Bubbles TikTok">
        <div class="relative inline-block w-[30px] h-[30px]" aria-hidden="true">
          <SiTiktok size={30} className="absolute top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2 text-black" />
          <SiTiktok size={20} className="absolute top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2 text-black" />
          <SiTiktok size={26} className="absolute top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2 text-white hover:text-yellow-500 transition" />
        </div>
      </a>

      <a href="https://www.facebook.com/clinkingbubbles" target="_blank" rel="noopener noreferrer" aria-label="Clinking Bubbles Facebook">
        <div class="relative inline-block w-[30px] h-[30px]" aria-hidden="true">
          <FaFacebookF size={28} className="absolute top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2 text-black" />
          <FaFacebookF size={30} className="absolute top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2 text-black" />
          <FaFacebookF size={26} className="absolute top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2 text-white hover:text-yellow-500 transition" />
        </div>
      </a>

      <a href="/contact" aria-label="Contact us via email">
        <div class="relative inline-block w-[30px] h-[30px]" aria-hidden="true">
          <FaEnvelope size={30} className="absolute top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2 text-black" />
          <FaEnvelope size={26} className="absolute top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2 text-white hover:text-yellow-500 transition" />
        </div>
      </a>
    </div>

    {/* Disclaimer — colors are the lightest shades that pass WCAG 4.5:1 on
        the #EBE6D6 footer background (axe color-contrast audit). */}
    <div class="text-sm text-[#5b6472]">
      <h3 class="text-[#8a5c08] font-bold">DRINK RESPONSIBLY</h3>
      <p class="mt-2">
        This website is intended for individuals 21 years of age or older. Please drink responsibly.
        We do not condone excessive or irresponsible alcohol consumption. Always comply with the laws and
        regulations in your area regarding alcohol use. If you or someone you know struggles with alcohol
        dependency, please seek help from a professional organization
        <a
          href="https://www.nj.gov/humanservices/reachnj/"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-block ml-1"
          aria-label="Link to professional help organization for alcohol use"
        >
          <FaExternalLinkAlt size={12} className="inline" />
        </a>.
      </p>
    </div>

    {/* Copyright */}
    <p class="mt-6 text-[#5b6472] text-xs">
      © {year} Clinking Bubbles LLC. All rights reserved.
    </p>
  </div>
</footer>
